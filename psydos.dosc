#include <stdio.h>#include <dos.h>#include "psy.h"#include "psyext.h"#undef	getchar#undef	putcharint	_Cdecl getchar(){	union	REGS	regs;	regs.h.ah = 0x07;	return (intdos(&regs,&regs) & 0xff);}int	_Cdecl putchar(c)int	c;{	union	REGS	regs;	regs.h.ah = 0x06;	regs.h.dl = c;		intdos(&regs,&regs);	return (c);}setblkh(a,b)unsigned	a;unsigned	b;{	union	REGS	regs;	struct	SREGS	sregs;	regs.h.ah = 0x4a;	sregs.es = a;	regs.x.bx = b;	intdosx(&regs,&regs,&sregs);}int		alloch(a)unsigned	a;{	union	REGS	regs;	regs.h.ah = 0x48;	regs.x.bx = a;	return (intdos(&regs,&regs));}_zero(a,b,c)unsigned	a;unsigned	b;unsigned	c;{	register long	far *flp = MK_FP(b,0);	register int	i;	for (i = 16383; i >= 0; i--)		*(flp + i) = 0;}wchar_t	getletr(register cmcellpt_t p){	return (((cmcell_t far *)MK_FP(heap[(p) >> 14],0) + ((p) & 0x3fff)) -> letter);}wchar_t	putletr(register cmcellpt_t p,wchar_t c){	return (((cmcell_t far *)MK_FP(heap[(p) >> 14],0) + ((p) & 0x3fff)) -> letter = (c));}cmcellpt_t	getnext(register cmcellpt_t p){	return (((cmcell_t far *)MK_FP(heap[(p) >> 14],0) + ((p) & 0x3fff)) -> next);}cmcellpt_t	putnext(register cmcellpt_t p,cmcellpt_t np){	return (((cmcell_t far *)MK_FP(heap[(p) >> 14],0) + ((p) & 0x3fff)) -> next = (np));}